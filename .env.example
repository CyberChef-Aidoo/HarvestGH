# Agro Bridge environment variables
# Copy to .env.local and fill in.

# Django API (exposed to the browser)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Paystack public key (browser). Use pk_test_ while testing.
NEXT_PUBLIC_PAYSTACK_KEY=pk_test_your_key

# Support contact
NEXT_PUBLIC_SUPPORT_PHONE=0544823484
NEXT_PUBLIC_SUPPORT_WHATSAPP=233544823484
NEXT_PUBLIC_SUPPORT_EMAIL=hello@agrobridge.gh
NEXT_PUBLIC_SUPPORT_CITY=Accra

# Server-only: Anthropic key for /api/assistant (never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
