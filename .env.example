# Agro Bridge environment variables
# Copy to .env.local and fill in. NEXT_PUBLIC_ vars are exposed to the browser.

# Django API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Paystack (Settings -> API Keys). Use pk_test_ while testing.
NEXT_PUBLIC_PAYSTACK_KEY=pk_test_your_key

# Support contact
NEXT_PUBLIC_SUPPORT_PHONE=0544823484
NEXT_PUBLIC_SUPPORT_WHATSAPP=233544823484
NEXT_PUBLIC_SUPPORT_EMAIL=hello@agrobridge.gh
NEXT_PUBLIC_SUPPORT_CITY=Accra

# Optional: Anthropic key for the AI chatbot (leave blank to use FAQ-only mode)
NEXT_PUBLIC_ANTHROPIC_KEY=
