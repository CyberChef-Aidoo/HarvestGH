# Copy to .env (do not commit .env)

# Required. Use a long unique value of your own. settings.py rejects an empty key
# and the old placeholder "dev-only-change-me-harvestgh".
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated browser origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave blank to use SQLite (backend/db.sqlite3)
DATABASE_URL=

# Public site URL used in image URLs returned by the API
PUBLIC_BASE_URL=http://127.0.0.1:8000
